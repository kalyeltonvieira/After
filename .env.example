# Keep credentials only in deployment secrets. Never commit real values or expose
# server credentials to the browser bundle.

# Required for backend Gemini calls.
GEMINI_API_KEY=""

# Public deployed app URL, used for OAuth callback URL construction.
APP_URL="https://your-app.example.com"

# GitHub OAuth app credentials; server-side only.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Server-side AES-256-GCM key: 32 random bytes represented by 64 hex characters.
GITHUB_TOKEN_ENCRYPTION_KEY=""

# Firebase Admin uses Application Default Credentials. Set project ID when needed.
FIREBASE_PROJECT_ID=""
# Optional named Firestore database ID; defaults to firebase-applet-config.json.
FIRESTORE_DATABASE_ID=""

# Webhook signature verification secret; server-side only.
GITHUB_WEBHOOK_SECRET=""

# Use production on HTTPS deployments (secure session cookies).
NODE_ENV=development
