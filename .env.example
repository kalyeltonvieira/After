# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET: Required for GitHub-first authentication.
# Register the callback URL below in the GitHub OAuth App configuration.
GITHUB_CLIENT_ID=
# GitHub OAuth callback: https://YOUR_APP_DOMAIN/auth/github/callback
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Firebase Admin SDK: backend verification uses Application Default Credentials.
# Set this to the Firebase project ID when deploying outside AI Studio.
# Do not use the AI Studio/hosting project ID when it differs from Firebase.
FIREBASE_PROJECT_ID=

# Set to production when served over HTTPS so the GitHub session cookie is Secure.
NODE_ENV=development

# Server-only encryption key for persisted GitHub OAuth tokens used by continuous observation.
# Must be 32 random bytes represented as 64 hexadecimal characters.
GITHUB_TOKEN_ENCRYPTION_KEY=
