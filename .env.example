# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links and API endpoints.
APP_URL="MY_APP_URL"

# AFTER accounts use Firebase Email/Password Authentication.
# GitHub is a separate optional integration linked after sign-in. Keep the GitHub
# provider enabled in Firebase Authentication for linkWithPopup; do not show it
# as a sign-in method in the AFTER UI.
# Firebase GitHub callback: https://afterbrasil.firebaseapp.com/__/auth/handler
# No separate GITHUB_CLIENT_ID/SECRET is required for this Firebase linking flow.
GITHUB_WEBHOOK_SECRET=

# Firebase Admin SDK: backend verification uses Application Default Credentials.
# Set this to the Firebase project ID when deploying outside AI Studio.
# Do not use the AI Studio/hosting project ID when it differs from Firebase.
FIREBASE_PROJECT_ID=
# Optional named Firestore database ID. If set, the runtime service account must
# have Datastore User/Viewer access to this database. Defaults to the checked-in
# firebase-applet-config.json value when omitted.
FIRESTORE_DATABASE_ID=

# Set to production when served over HTTPS so the GitHub session cookie is Secure.
NODE_ENV=development

# Server-only encryption key for persisted GitHub OAuth tokens used by continuous observation.
# Must be 32 random bytes represented as 64 hexadecimal characters.
GITHUB_TOKEN_ENCRYPTION_KEY=

# GitHub OAuth App credentials. Store these only in the deployment secret manager.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
