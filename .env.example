# IMPORTANT: Keep secrets only on the backend and in deployment secrets.
# Never expose these values to the browser or commit real credentials.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed app. This is used for OAuth redirects.
# Example: https://your-app.run.app
APP_URL="https://your-app.example.com"

# GitHub OAuth app credentials. Store these in deployment secret storage only.
# The frontend must never read them directly.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Used to encrypt persisted GitHub tokens stored server-side.
# Must be exactly 64 hex chars (32 random bytes).
GITHUB_TOKEN_ENCRYPTION_KEY=""

# Firebase Admin SDK: backend verification uses Application Default Credentials.
# Set this to the Firebase project ID when deploying outside AI Studio.
# Prefer the real Firebase project, not the hosting project id.
FIREBASE_PROJECT_ID=""

# Optional named Firestore database ID. Defaults to the checked-in
# firebase-applet-config.json setting when omitted.
FIRESTORE_DATABASE_ID=""

# Set to production when served over HTTPS so the GitHub session cookie is Secure.
NODE_ENV=development

# GitHub webhook secret used to validate incoming webhook payloads.
GITHUB_WEBHOOK_SECRET=""
