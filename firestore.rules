rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Connectivity probe
    match /test/{testId} {
      allow read: if true;
    }

    // User profile documents: users/{userId}
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Username reservation registry: usernames/{username}
    // Public read allows checking handle availability during onboarding
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        username.matches('^[a-z0-9_]{3,30}$');
      allow update: if isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Projects collection: projects/{projectId}
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.ownerId == request.auth.uid || resource == null);
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // Project Events subcollection
      match /events/{eventId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }

      // Project Insights subcollection
      match /insights/{insightId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }

      // Project Experiments subcollection
      match /experiments/{experimentId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }
  }
}
