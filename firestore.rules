rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsProject(projectId) {
      return signedIn() && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
    }

    match /test/{testId} { allow read: if true; }
    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }
    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && username.matches('^[a-z0-9_]{3,30}$');
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /projects/{projectId} {
      allow read, delete: if ownsProject(projectId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if ownsProject(projectId) && request.resource.data.ownerId == resource.data.ownerId;
      match /events/{eventId} { allow read, write: if ownsProject(projectId); }
      match /snapshots/{snapshotId} { allow read, write: if ownsProject(projectId); }
      match /insights/{insightId} { allow read, write: if ownsProject(projectId); }
      match /memoryEntries/{entryId} { allow read, write: if ownsProject(projectId); }
      match /experiments/{experimentId} { allow read, write: if ownsProject(projectId); }
      match /watchTargets/{watchId} { allow read, write: if ownsProject(projectId); }
      match /notifications/{notificationId} { allow read, write: if ownsProject(projectId); }
      match /analysisJobs/{jobId} { allow read, write: if ownsProject(projectId); }
    }
  }
}
